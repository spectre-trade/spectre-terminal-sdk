{
  "name": "@spectre-trade/terminal",
  "version": "0.1.0-rc.3",
  "description": "TypeScript client for the Local API of Spectre Terminal: connections, instruments, trades, order books, clusters, candles, the account and order placement over HTTP and WebSocket on 127.0.0.1",
  "keywords": [
    "spectre",
    "trading",
    "terminal",
    "market-data",
    "orderbook",
    "websocket"
  ],
  "license": "MIT",
  "homepage": "https://github.com/spectre-trade/spectre-terminal-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectre-trade/spectre-terminal-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/spectre-trade/spectre-terminal-sdk/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  }
}
